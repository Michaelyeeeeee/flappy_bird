// vga_flappy.sv
// Single-file SystemVerilog Flappy Bird (VGA) for 640x480 visible area.
// Input:  clk (48 MHz), button (active-high pushbutton).
// Outputs: rgb[2:0], hsync, vsync.
// Bird flaps up by 40 pixels on one button press (no repeat while held).

module vga_flappy(
    input  logic clk,           // 48 MHz input clock
    input  logic button_raw,    // active-high pushbutton (may be mechanical)
    output logic [2:0] rgb,     // 3-bit RGB output
    output logic hsync,
    output logic vsync
);

    // ---------------------------------------------------------------------
    // Timing parameters (standard 640x480 @60-ish Hz timings, totals: 800x525)
    // ---------------------------------------------------------------------
    localparam H_VISIBLE   = 640;
    localparam H_FRONT     = 16;
    localparam H_SYNC      = 96;
    localparam H_BACK      = 48;
    localparam H_TOTAL     = H_VISIBLE + H_FRONT + H_SYNC + H_BACK; // 800

    localparam V_VISIBLE   = 480;
    localparam V_FRONT     = 10;
    localparam V_SYNC      = 2;
    localparam V_BACK      = 33;
    localparam V_TOTAL     = V_VISIBLE + V_FRONT + V_SYNC + V_BACK; // 525

    // ---------------------------------------------------------------------
    // Pixel clock generation: divide 48 MHz by 2 -> 24 MHz pixel clock
    // (If you have a PLL, replace this with an accurate 25.175 MHz pixel clock)
    // ---------------------------------------------------------------------
    logic pixel_clk;
    logic clk_div2;
    always_ff @(posedge clk) clk_div2 <= ~clk_div2;
    assign pixel_clk = clk_div2; // ~24 MHz

    // ---------------------------------------------------------------------
    // VGA counters (pixel coordinates across the entire timing area)
    // ---------------------------------------------------------------------
    logic [$clog2(H_TOTAL)-1:0] h_cnt;
    logic [$clog2(V_TOTAL)-1:0] v_cnt;

    always_ff @(posedge pixel_clk) begin
        if (h_cnt == H_TOTAL - 1) begin
            h_cnt <= 0;
            if (v_cnt == V_TOTAL - 1)
                v_cnt <= 0;
            else
                v_cnt <= v_cnt + 1;
        end else begin
            h_cnt <= h_cnt + 1;
        end
    end

    // Visible pixel coordinates (0..639, 0..479)
    logic in_visible;
    logic [9:0] pixel_x, pixel_y;
    always_comb begin
        // active window when h within back+visible and v within back+visible
        // typical mapping: after h_back comes visible window
        // compute visible region start indices:
        int h_visible_start = H_SYNC + H_BACK; // sync + back porch
        int h_visible_end   = h_visible_start + H_VISIBLE - 1;
        int v_visible_start = V_SYNC + V_BACK;
        int v_visible_end   = v_visible_start + V_VISIBLE - 1;

        if ((h_cnt >= h_visible_start && h_cnt <= h_visible_end) &&
            (v_cnt >= v_visible_start && v_cnt <= v_visible_end)) begin
            in_visible = 1;
            pixel_x = h_cnt - h_visible_start;
            pixel_y = v_cnt - v_visible_start;
        end else begin
            in_visible = 0;
            pixel_x = 0;
            pixel_y = 0;
        end
    end

    // HSYNC / VSYNC (active-low for VGA)
    // hsync asserted during the sync pulse window (after front porch)
    always_comb begin
        hsync = ~((h_cnt >= (H_VISIBLE + H_FRONT)) && (h_cnt < (H_VISIBLE + H_FRONT + H_SYNC)));
        vsync = ~((v_cnt >= (V_VISIBLE + V_FRONT)) && (v_cnt < (V_VISIBLE + V_FRONT + V_SYNC)));
    end

    // ---------------------------------------------------------------------
    // One-frame tick: when v_cnt==0 and h_cnt==0 (start of frame)
    // We'll update game physics / move pipes on this tick.
    // ---------------------------------------------------------------------
    logic frame_tick;
    always_ff @(posedge pixel_clk) begin
        frame_tick <= (h_cnt == 0 && v_cnt == 0);
    end

    // ---------------------------------------------------------------------
    // Button sync + simple debouncer + single-pulse edge detection
    // - produce `button_pulse` which is high for 1 frame_tick when a press is detected
    // ---------------------------------------------------------------------
    // Synchronize to pixel_clk
    logic button_sync_0, button_sync_1;
    always_ff @(posedge pixel_clk) begin
        button_sync_0 <= button_raw;
        button_sync_1 <= button_sync_0;
    end

    // Debounce: require stable press for a small number of pixel_clk cycles.
    // We'll use a 12-bit counter (fine enough). Debounce only for press edges.
    localparam DEBOUNCE_BITS = 12;
    logic [DEBOUNCE_BITS-1:0] db_cnt;
    logic button_db; // debounced button

    always_ff @(posedge pixel_clk) begin
        if (button_sync_1) begin
            if (db_cnt != {DEBOUNCE_BITS{1'b1}}) db_cnt <= db_cnt + 1;
        end else begin
            db_cnt <= 0;
        end
        button_db <= (db_cnt == {DEBOUNCE_BITS{1'b1}});
    end

    // Edge detection on debounced button, produce a pulse aligned to frame_tick:
    // We latch the edge when it happens and then output button_pulse on next frame_tick.
    logic button_db_prev;
    logic button_edge_latched;
    logic button_pulse; // goes high for one frame tick when a press occurred

    always_ff @(posedge pixel_clk) begin
        button_db_prev <= button_db;
        // detect rising edge
        if (button_db && !button_db_prev)
            button_edge_latched <= 1;
        // clear when consumed at frame tick
        if (frame_tick)
            button_pulse <= button_edge_latched;
        else
            button_pulse <= 0;

        if (frame_tick)
            button_edge_latched <= 0;
    end

    // ---------------------------------------------------------------------
    // Game state: bird, pipes, collisions
    // Bird moves up instantly by 40 pixels when button_pulse asserted on that frame.
    // Otherwise gravity pulls it down by GRAVITY_PER_FRAME pixels each frame.
    // ---------------------------------------------------------------------
    // Parameters you can tune
    localparam integer START_BIRD_Y = V_VISIBLE/2;
    localparam integer BIRD_WIDTH   = 24;   // horizontal span of bird (pixels)
    localparam integer BIRD_HEIGHT  = 24;   // vertical span of bird
    localparam integer BIRD_X_POS   = 160;  // fixed horizontal position of bird
    localparam integer FLAP_PIXELS  = 40;   // instant upward move on flap
    localparam integer GRAVITY_PER_FRAME = 4;// pixels bird falls per frame
    localparam integer PIPE_WIDTH   = 52;
    localparam integer PIPE_GAP     = 120;  // vertical gap between top and bottom pipe
    localparam integer PIPE_SPEED   = 4;    // pixels per frame pipe moves left
    localparam integer NUM_PIPES    = 3;
    localparam integer PIPE_SPACING = 240;  // horizontal spacing between pipes (pixels)

    // Bird position (0..V_VISIBLE-1)
    logic signed [11:0] bird_y; // signed to allow negative intermediate
    // Lives / collision
    logic collided;

    // Pipes: arrays of x positions and gap_y positions (top of gap)
    logic signed [11:0] pipe_x [NUM_PIPES-1:0];
    logic signed [11:0] pipe_gap_y [NUM_PIPES-1:0];

    // LFSR for pseudo-random gap generation
    logic [15:0] lfsr;
    always_ff @(posedge pixel_clk) begin
        if (frame_tick && (v_cnt == 0 && h_cnt == 0) && lfsr == 16'd0)
            lfsr <= 16'hACE1; // seed if zero
        else if (frame_tick) begin
            // advance LFSR once per frame (xorshift style)
            lfsr <= {lfsr[14:0], lfsr[15] ^ lfsr[13] ^ lfsr[12] ^ lfsr[10]};
        end
    end

    // Initialize or update game entities on frame_tick
    integer i;
    always_ff @(posedge pixel_clk) begin
        if (frame_tick) begin
            // reset on first power-up (if pipe_x all zero, initialize)
            if (pipe_x[0] === 'x) begin
                // initialize pipes spaced off-screen
                for (i = 0; i < NUM_PIPES; i = i + 1) begin
                    pipe_x[i] <= H_VISIBLE + i * PIPE_SPACING;
                    // gap y in range [50 .. V_VISIBLE-50-PIPE_GAP]
                    pipe_gap_y[i] <= 50 + (lfsr[7:0] * (V_VISIBLE - 100 - PIPE_GAP)) / 255;
                end
                bird_y <= START_BIRD_Y;
                collided <= 0;
            end else if (!collided) begin
                // Bird flap or gravity
                if (button_pulse) begin
                    // instant upward move FLAP_PIXELS
                    bird_y <= bird_y - FLAP_PIXELS;
                end else begin
                    bird_y <= bird_y + GRAVITY_PER_FRAME;
                end

                // clamp bird to screen
                if (bird_y < 0) bird_y <= 0;
                if (bird_y > V_VISIBLE - BIRD_HEIGHT) bird_y <= V_VISIBLE - BIRD_HEIGHT;

                // Move pipes left
                for (i = 0; i < NUM_PIPES; i = i + 1) begin
                    pipe_x[i] <= pipe_x[i] - PIPE_SPEED;
                    // when a pipe goes completely off left, wrap to right and new gap
                    if (pipe_x[i] + PIPE_WIDTH <= -20) begin
                        pipe_x[i] <= H_VISIBLE + (NUM_PIPES - 1) * PIPE_SPACING;
                        // new random gap using lfsr
                        pipe_gap_y[i] <= 50 + (lfsr[7:0] * (V_VISIBLE - 100 - PIPE_GAP)) / 255;
                    end
                end

                // Collision check: simple AABB overlap with any pipe rectangle excluding gap
                collided <= 0;
                for (i = 0; i < NUM_PIPES; i = i + 1) begin
                    // pipe horizontal overlap with bird?
                    if ((pipe_x[i] < BIRD_X_POS + BIRD_WIDTH) && (pipe_x[i] + PIPE_WIDTH > BIRD_X_POS)) begin
                        // top pipe rectangle: y in [0, gap_y-1]
                        if (bird_y < pipe_gap_y[i]) begin
                            // bird top intersects top pipe
                            if (bird_y + BIRD_HEIGHT > 0) collided <= 1;
                        end
                        // bottom pipe rectangle: y in [gap_y+PIPE_GAP, V_VISIBLE-1]
                        if (bird_y + BIRD_HEIGHT > pipe_gap_y[i] + PIPE_GAP) begin
                            collided <= 1;
                        end
                    end
                end

                // ground/ceiling collision
                if (bird_y <= 0 || bird_y >= V_VISIBLE - BIRD_HEIGHT) collided <= 1;
            end else begin
                // collided: press button to restart (single pulse)
                if (button_pulse) begin
                    // reset game
                    bird_y <= START_BIRD_Y;
                    collided <= 0;
                    // reinitialize pipes spaced to the right
                    for (i = 0; i < NUM_PIPES; i = i + 1) begin
                        pipe_x[i] <= H_VISIBLE + i * PIPE_SPACING;
                        pipe_gap_y[i] <= 50 + (lfsr[7:0] * (V_VISIBLE - 100 - PIPE_GAP)) / 255;
                    end
                end
            end
        end
    end

    // ---------------------------------------------------------------------
    // Rendering: choose color for each visible pixel
    // - background: sky (blue-ish)
    // - bird: yellow-ish
    // - pipes: green
    // - on collision: flash red bird
    // ---------------------------------------------------------------------
    logic bird_pixel;
    logic pipe_pixel;
    logic ground_pixel;

    always_comb begin
        bird_pixel = 0;
        pipe_pixel = 0;
        ground_pixel = 0;

        if (in_visible) begin
            // Bird box
            if ((pixel_x >= BIRD_X_POS) && (pixel_x < BIRD_X_POS + BIRD_WIDTH) &&
                (pixel_y >= bird_y) && (pixel_y < bird_y + BIRD_HEIGHT)) begin
                bird_pixel = 1;
            end

            // Pipes
            for (int j = 0; j < NUM_PIPES; j++) begin
                if ((pixel_x >= pipe_x[j]) && (pixel_x < pipe_x[j] + PIPE_WIDTH)) begin
                    // if in top pipe region
                    if (pixel_y < pipe_gap_y[j]) pipe_pixel = 1;
                    // if in bottom pipe region
                    if (pixel_y >= pipe_gap_y[j] + PIPE_GAP) pipe_pixel = 1;
                end
            end

            // ground strip at bottom
            if (pixel_y >= V_VISIBLE - 20) ground_pixel = 1;
        end
    end

    // RGB mapping (3 bits)
    always_comb begin
        // Default background sky
        rgb = 3'b001; // dark blue

        if (!in_visible) begin
            rgb = 3'b000; // black outside visible area
        end else begin
            if (pipe_pixel) begin
                rgb = 3'b010; // green pipe
            end
            if (ground_pixel) begin
                rgb = 3'b011; // brown-ish ground (green+blue bit)
            end
            if (bird_pixel) begin
                if (collided && (v_cnt[4:0] == 0)) // flash when collided
                    rgb = 3'b100; // red
                else
                    rgb = 3'b110; // yellow bird
            end
        end
    end

endmodule

